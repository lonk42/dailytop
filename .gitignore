# Runtime secrets (USER_PASSWORD etc.) -- never commit
.env

# Build args for this machine; the example is tracked, the file is not.
# See build.args.example.
build.args

# Extra CA certificates are environment-specific; the directory and its README are
# tracked, the certs are not. See certs/README.md.
certs/*.crt
certs/*.pem

# The desktop's /config home when bind-mounted here (large; caches, tokens, history)
config/

# The nested dockerd's data root when mounted here. See docker-compose.yaml.
docker/

# Editor cruft
*.swp
*.swo
*~
.DS_Store
