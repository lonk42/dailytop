# Copy to .env and edit. Read by docker-compose.yaml; .env is gitignored.

# Image to run. Build it with ./build.sh full (or point at a registry copy).
IMAGE=dailytop:full

# Password for the in-container `abc` and `root` accounts, applied at container start
# by /custom-cont-init.d/01-set-passwords.sh. REQUIRED for the `full` image: the KDE
# lock screen greets you at session start and there is nothing to unlock it with
# otherwise. Not baked into any image layer.
USER_PASSWORD=change-me

# Ownership of /config inside the container. Match your host user for a bind mount.
PUID=1000
PGID=1000

# Desktop locale/appearance
TZ=UTC
TITLE=dailytop
KEYBOARD=en-us-qwerty

# Skip the lock screen at session start (the image defaults to locking).
# LOCK_ON_STARTUP=false

# Use a config file of your own for the sshd service instead of /defaults/sshd_config.
# SSHD_CONFIG=/config/.ssh/sshd_config

# Extra root CAs are read from /certs, which docker-compose.yaml mounts from ./certs.
# Override the in-container path here if you mount them somewhere else.
# CA_CERT_DIR=/certs

# Registry host[:port] using a private CA. The certificates in CA_CERT_DIR are also
# written to /etc/docker/certs.d/<host>/ so the inner DinD daemon trusts the registry.
# PRIVATE_REGISTRY=registry.example.com
